seedIfEmpty();

// ---------------------------------------------------------------------------
// Tiny query-builder that mimics the subset of the Supabase JS client this
// project uses: .from().select().eq().gte().lte().ilike().order().limit()
// .single()/.maybeSingle()/.insert()/.update()/.delete() -- all awaitable.
// ---------------------------------------------------------------------------
type Filter = { field: string; op: 'eq' | 'gte' | 'lte' | 'ilike'; value: any };

class QueryBuilder implements PromiseLike<{ data: any; error: any; count?: number }> {
  private filters: Filter[] = [];
  private orFilters: Filter[] = [];
  private orderField?: string;
  private orderAsc = true;
  private limitN?: number;
  private mode: 'select' | 'insert' | 'update' | 'delete' = 'select';
  private payload?: any;
  private singleMode: 'one' | 'maybe' | null = null;
  private wantCount = false;

  constructor(private table: TableName, private cols: string = '*') {}

  select(cols: string = '*', opts?: { count?: string; head?: boolean }) {
    this.cols = cols;
    if (opts?.count) this.wantCount = true;
    return this;
  }
  eq(field: string, value: any) { this.filters.push({ field, op: 'eq', value }); return this; }
  gte(field: string, value: any) { this.filters.push({ field, op: 'gte', value }); return this; }
  lte(field: string, value: any) { this.filters.push({ field, op: 'lte', value }); return this; }
  ilike(field: string, value: string) { this.filters.push({ field, op: 'ilike', value: String(value).replace(/%/g, '') }); return this; }
  /**
   * Supabase-style OR filter: a comma-separated string of "field.op.value"
   * conditions, e.g. "name.ilike.%phone%,description.ilike.%phone%" — a row
   * matches if it satisfies ALL regular filters AND AT LEAST ONE of these.
   */
  or(condition: string) {
    condition.split(',').forEach(part => {
      const [field, op, rawValue] = part.split('.');
      if (!field || !op) return;
      const value = op === 'ilike' ? rawValue.replace(/%/g, '') : rawValue;
      this.orFilters.push({ field, op: op as Filter['op'], value });
    });
    return this;
  }
  order(field: string, opts?: { ascending?: boolean }) { this.orderField = field; this.orderAsc = opts?.ascending !== false; return this; }
  limit(n: number) { this.limitN = n; return this; }
  single() { this.singleMode = 'one'; return this; }
  maybeSingle() { this.singleMode = 'maybe'; return this; }
  insert(payload: any) { this.mode = 'insert'; this.payload = payload; return this; }
  update(payload: any) { this.mode = 'update'; this.payload = payload; return this; }
  delete() { this.mode = 'delete'; return this; }

  private matchesFilter(row: Row, f: Filter): boolean {
    const v = row[f.field];
    if (f.op === 'eq') return v === f.value;
    if (f.op === 'gte') return v >= f.value;
    if (f.op === 'lte') return v <= f.value;
    if (f.op === 'ilike') return String(v ?? '').toLowerCase().includes(String(f.value).toLowerCase());
    return true;
  }

  private applyFilters(rows: Row[]): Row[] {
    return rows.filter(row => {
      const passesAnd = this.filters.every(f => this.matchesFilter(row, f));
      if (!passesAnd) return false;
      if (this.orFilters.length === 0) return true;
      return this.orFilters.some(f => this.matchesFilter(row, f));
    });
  }

  private attachRelations(row: Row): Row {
    const out = { ...row };
    if (this.table === 'products' && this.cols.includes('categories')) {
      const cats = loadTable('categories');
      out.categories = cats.find(c => c.id === row.category_id) || null;
    }
    if (this.table === 'categories' && this.cols.includes('products')) {
      const prods = loadTable('products');
      out.products = prods.filter(p => p.category_id === row.id).map(p => ({ id: p.id }));
    }
    if (this.table === 'orders' && this.cols.includes('order_items')) {
      const items = loadTable('order_items');
      out.order_items = items.filter(i => i.order_id === row.id);
    }
    return out;
  }

  private async execute(): Promise<{ data: any; error: any; count?: number }> {
    try {
      let rows = loadTable(this.table);

      if (this.mode === 'insert') {
        const items = Array.isArray(this.payload) ? this.payload : [this.payload];
        const inserted = items.map(item => ({ id: uid(), created_at: now(), ...item }));
        saveTable(this.table, [...rows, ...inserted]);
        const result = inserted.map(r => this.attachRelations(r));
        return { data: this.singleMode ? result[0] : result, error: null };
      }

      if (this.mode === 'update') {
        const matched = this.applyFilters(rows);
        const matchedIds = new Set(matched.map(r => r.id));
        rows = rows.map(r => (matchedIds.has(r.id) ? { ...r, ...this.payload } : r));
        saveTable(this.table, rows);
        const result = matched.map(r => this.attachRelations({ ...r, ...this.payload }));
        return { data: this.singleMode ? result[0] ?? null : result, error: null };
      }

      if (this.mode === 'delete') {
        const matched = this.applyFilters(rows);
        const matchedIds = new Set(matched.map(r => r.id));
        saveTable(this.table, rows.filter(r => !matchedIds.has(r.id)));
        return { data: matched, error: null };
      }

      // select
      let result = this.applyFilters(rows);
      const count = result.length;
      if (this.orderField) {
        const field = this.orderField;
        result = [...result].sort((a, b) => {
          const av = a[field]; const bv = b[field];
          if (av < bv) return this.orderAsc ? -1 : 1;
          if (av > bv) return this.orderAsc ? 1 : -1;
          return 0;
        });
      }
      if (this.limitN !== undefined) result = result.slice(0, this.limitN);
      result = result.map(r => this.attachRelations(r));

      if (this.singleMode === 'one') {
        return { data: result[0] ?? null, error: result[0] ? null : { message: 'Row not found' } };
      }
      if (this.singleMode === 'maybe') {
        return { data: result[0] ?? null, error: null };
      }
      return { data: result, error: null, count: this.wantCount ? count : undefined };
    } catch (e: any) {
      return { data: null, error: { message: e?.message || 'Local database error' } };
    }
  }

  then<R1 = any, R2 = never>(
    onfulfilled?: ((value: { data: any; error: any; count?: number }) => R1 | PromiseLike<R1>) | null,
    onrejected?: ((reason: any) => R2 | PromiseLike<R2>) | null
  ): PromiseLike<R1 | R2> {
    return this.execute().then(onfulfilled as any, onrejected as any);
  }
}

// ---------------------------------------------------------------------------
// Auth (local, browser-only) -- replaces supabase.auth.*
// Default admin login: owner@abrgadgets.pk / AbrGadgets2026
// ---------------------------------------------------------------------------
const auth = {
  async signInWithPassword({ email, password }: { email: string; password: string }) {
    const users: { email: string; password: string }[] = JSON.parse(localStorage.getItem('ccm_db_auth_users') || '[]');
    const match = users.find(u => u.email.toLowerCase() === email.toLowerCase().trim() && u.password === password);
    if (!match) return { data: { session: null }, error: { message: 'Invalid email or password.' } };
    const session = { user: { email: match.email } };
    localStorage.setItem('ccm_db_session', JSON.stringify(session));
    return { data: { session }, error: null };
  },
  async signOut() {
    localStorage.removeItem('ccm_db_session');
    return { error: null };
  },
  async getSession() {
    const raw = localStorage.getItem('ccm_db_session');
    return { data: { session: raw ? JSON.parse(raw) : null }, error: null };
  },
};

// ---------------------------------------------------------------------------
// Storage (local, browser-only) -- replaces supabase.storage.*
// Uploaded images are converted to base64 data URLs and kept in localStorage.
// ---------------------------------------------------------------------------
function fileToDataUrl(file: File): Promise<string> {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result as string);
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });
}

const storage = {
  from(_bucket: string) {
    return {
      async upload(path: string, file: File, _opts?: any) {
        try {
          const dataUrl = await fileToDataUrl(file);
          const map = JSON.parse(localStorage.getItem('ccm_db_files') || '{}');
          map[path] = dataUrl;
          localStorage.setItem('ccm_db_files', JSON.stringify(map));
          return { data: { path }, error: null };
        } catch (e: any) {
          return { data: null, error: { message: e?.message || 'Upload failed' } };
        }
      },
      getPublicUrl(path: string) {
        const map = JSON.parse(localStorage.getItem('ccm_db_files') || '{}');
        return { data: { publicUrl: map[path] || '' } };
      },
    };
  },
};

// ---------------------------------------------------------------------------
// Public client -- same shape the rest of the app already imports
// ---------------------------------------------------------------------------
export const supabase = {
  from(table: TableName) {
    return new QueryBuilder(table);
  },
  auth,
  storage,
};
