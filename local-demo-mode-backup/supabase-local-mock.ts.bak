/* eslint-disable @typescript-eslint/no-explicit-any -- this file mimics the
   Supabase JS client's dynamic query-builder shape (rows of arbitrary table
   schemas), the same reason the real @supabase/supabase-js types rely on
   generics/any internally. Every consumer of `supabase.from(...)` still gets
   full type safety because it casts results to the app's real types. */
// ---------------------------------------------------------------------------
// LOCAL DATABASE (no external account / no internet backend required)
// ---------------------------------------------------------------------------
// This file used to connect to Supabase (a cloud database). It now stores
// everything inside the browser's own storage (localStorage) instead, using
// the SAME function names/shapes the rest of the app already calls
// (supabase.from('table').select()...). That means every other file in this
// project works unchanged -- only this file is different.
//
// Data lives in the browser it was created in. If you want a real shared
// cloud database later (multiple devices/staff seeing the same data), you
// can reconnect Supabase by restoring the original client here -- everything
// else in the app already speaks that exact query shape.
// ---------------------------------------------------------------------------

type Row = Record<string, any>;

const uid = () => `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
const now = () => new Date().toISOString();

type TableName = 'products' | 'categories' | 'orders' | 'order_items' | 'reviews' | 'admin_users';

function loadTable(table: string): Row[] {
  try {
    const raw = localStorage.getItem(`ccm_db_${table}`);
    return raw ? JSON.parse(raw) : [];
  } catch {
    return [];
  }
}

function saveTable(table: string, rows: Row[]) {
  localStorage.setItem(`ccm_db_${table}`, JSON.stringify(rows));
}

// ---------------------------------------------------------------------------
// Seed data -- versioned so that whenever the demo catalog changes in code,
// every browser automatically picks up the fresh data on next load instead
// of being stuck with whatever was first saved (this was the #1 cause of
// "my changes aren't showing up" confusion during development).
// Bump SEED_VERSION any time the seed data below is changed.
// ---------------------------------------------------------------------------
const SEED_VERSION = 'v4-abr-2026-09-12';

function seedIfEmpty() {
  if (localStorage.getItem('ccm_db_seed_version') === SEED_VERSION) return;

  // Clear everything and reseed fresh. (Safe during setup/testing; once the
  // store is live with real orders, stop bumping SEED_VERSION casually.)
  ['products', 'categories', 'orders', 'order_items', 'reviews', 'admin_users'].forEach(t =>
    localStorage.removeItem(`ccm_db_${t}`)
  );

  const categories: Row[] = [
    { id: uid(), name: 'Microphones', slug: 'microphones', image_url: '/images/categories/microphones.jpg', created_at: now() },
