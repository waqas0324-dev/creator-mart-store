  const products: Row[] = [
    { id: uid(), name: 'Lavalier Collar Microphone', slug: 'lavalier-collar-microphone', description: 'Omni-directional lavalier microphone, perfect for video recording, interviews, YouTube, and vlogging. Delivers high-quality sound and is compatible with smartphones, DSLR cameras, and PCs.', price: 1490, original_price: 1990, category_id: catId('microphones'), image_url: '/images/categories/microphones.jpg', images: ['/images/categories/microphones.jpg', '/images/products/mic-illustration.jpg'], rating: 5.0, review_count: 2, stock: 50, is_featured: true, is_bestseller: true, discount_percent: 25, created_at: now() },
    { id: uid(), name: 'Aluminum Tripod Stand 3366', slug: 'aluminum-tripod-stand-3366', description: 'Lightweight aluminum tripod stand, adjustable height, ideal for cameras and phones.', price: 1699, original_price: 1999, category_id: catId('tripods'), image_url: '/images/categories/tripods.jpg', images: ['/images/categories/tripods.jpg', '/images/products/df06491e.jpg'], rating: 4.5, review_count: 1, stock: 40, is_featured: true, is_bestseller: true, discount_percent: 15, created_at: now() },
