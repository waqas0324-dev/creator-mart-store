    { id: uid(), name: '10000mAh Power Bank', slug: '10000mah-power-bank', description: 'Fast-charging compact power bank with dual USB output, keeps your devices charged on the go.', price: 1899, original_price: 2299, category_id: catId('power-banks'), image_url: '/images/categories/power-banks.jpg', images: ['/images/categories/power-banks.jpg', '/images/products/5a8d426b.jpg'], rating: 4.5, review_count: 2, stock: 60, is_featured: true, is_bestseller: true, discount_percent: 25, created_at: now() },
